# Copiar a .env. Todas opcionales: hay valores por defecto sensatos.

# Modelo (intercambiable)
SPEAKER_MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_EMBEDDING_DIM=192

# Selección de segmento
SPEAKER_TARGET_SECONDS=45
SPEAKER_MIN_SECONDS=8
SPEAKER_SAMPLE_RATE=16000

# Umbrales de similitud (SIN CALIBRAR — ajustar con datos reales)
SPEAKER_HIGH_THRESHOLD=0.75
SPEAKER_MEDIUM_THRESHOLD=0.55
SPEAKER_LOW_THRESHOLD=0.40

SPEAKER_LOG_LEVEL=INFO
